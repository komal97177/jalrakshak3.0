APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./jalrakshak.db
ADMIN_EMAILS=you@example.com
# Email (free): Brevo SMTP (smtp-relay.brevo.com:587) or Gmail SMTP (smtp.gmail.com:587 + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CRON_KEY=make-a-random-key
# Demo only: shows the sign-in code on screen when SMTP is not set up. Remove in production.
DEV_SHOW_OTP=1
COOKIE_SECURE=0
